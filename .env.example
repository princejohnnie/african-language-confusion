# Copy this file to .env and fill in your real keys. .env is gitignored --
# never commit real API keys.

OPENROUTER_API_KEY=
CMU_OPENAI_API_KEY=

# Optional -- only silences the Hugging Face Hub rate-limit warning in
# Build_Prompt_Dataset.ipynb and speeds up dataset downloads. Get one at
# https://huggingface.co/settings/tokens (a read-only token is enough).
HF_TOKEN=
